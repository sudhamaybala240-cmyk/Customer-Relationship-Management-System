NODE_ENV=development
PORT=5000

# Use a dedicated database for auth; do not share the CRM database.
# For Render with Railway MySQL, set this to Railway's public MYSQL_PUBLIC_URL.
# AUTH_MYSQL_PUBLIC_URL=mysql://<user>:<password>@<public-proxy-host>:<public-proxy-port>/<auth-database>

# For Railway private networking or local development, use the auth database URL.
# AUTH_DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<auth-database>

# Alternative local/native MySQL settings.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=propflow_auth
DB_USER=root
DB_PASSWORD=replace-with-local-database-password

FRONTEND_URLS=https://customer-relationship-management-sy-nine.vercel.app,
https://customer-relationship-management-system-b7qvwpq7c.vercel.app,
https://customer-relationship-managemen-git-5f3c3d-sudhamaybala240-cmyk.vercel.app,
https://customer-relationship-management-system-exb9ik7hu.vercel.app

REDIS_HOST=localhost
REDIS_PORT=6379
