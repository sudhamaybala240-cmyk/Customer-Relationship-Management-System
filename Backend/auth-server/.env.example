PORT=5000
FRONTEND_URL=https://customer-relationship-management-sy-nine.vercel.app

# For Railway, prefer AUTH_DATABASE_URL referencing a dedicated auth MySQL service.
# Local development can use the DB_* values below.
AUTH_DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=propflow
DB_USER=root
DB_PASSWORD=replace-with-local-database-password

CRM_DB_HOST=localhost
CRM_DB_PORT=3306
CRM_DB_NAME=crm
CRM_DB_USER=root
CRM_DB_PASSWORD=replace-with-local-database-password

REDIS_HOST=localhost
REDIS_PORT=6379