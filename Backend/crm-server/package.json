{
  "name": "crm-server",
  "version": "1.0.0",
  "description": "PropFlow CRM API",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --prefer-ts src/index.ts",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "build": "tsc",
    "seed": "ts-node --transpile-only src/seed.ts",
    "start": "node dist/src/index.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.1",
    "node-cron": "^4.6.0",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "jest": "^30.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
