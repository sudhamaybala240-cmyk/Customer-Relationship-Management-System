NODE_ENV=development
PORT=6000
FRONTEND_URL=https://customer-relationship-management-sy-nine.vercel.app

# Use DATABASE_URL for local/direct MySQL connections.
# DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<database>

# For Render with Railway MySQL, enable Railway TCP Proxy and use the public URL.
# MYSQL_PUBLIC_URL=mysql://<user>:<password>@<public-proxy-host>:<public-proxy-port>/<database>

REDIS_HOST=localhost
REDIS_PORT=6379

AUTH_SERVER_URL=http://localhost:5000
JWKS_URL=http://localhost:5000/.well-known/jwks.json
